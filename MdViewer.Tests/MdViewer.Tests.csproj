<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the parts that need no window: PathFinder, SafePath, TextFiles. The source files
       are compiled in directly, so the tests do not need the WinForms / WebView2 app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MdViewer\PathFinder.cs" Link="PathFinder.cs" />
    <Compile Include="..\MdViewer\SafePath.cs" Link="SafePath.cs" />
    <Compile Include="..\MdViewer\TextFiles.cs" Link="TextFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
