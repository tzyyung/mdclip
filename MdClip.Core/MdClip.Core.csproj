<Project Sdk="Microsoft.NET.Sdk">

  <!-- What MdClip does without a window: turning copied text into files, paths and file kinds,
       existence checks that do not hang on dead network shares, reading text files, the settings file.
       Shared by the app and by MdClip.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdClip</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
  </ItemGroup>

</Project>
